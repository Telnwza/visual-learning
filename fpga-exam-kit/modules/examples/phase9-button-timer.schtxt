format schematic-text 1
circuit button_timer_display
input clk, rst, en, start_button, pause_button, load, down, load_minutes[7], load_seconds[6]
output segment[7], dp, common[4], running, done, valid, load_error
use "CUSTOM:ss_button_input" as button
use "CUSTOM:ss_mmss_timer" as timer
use "CUSTOM:ss_bus_zero_extend" as extend
use "CUSTOM:ss_sevenseg_digits" as pack
use "CUSTOM:ss_sevenseg_scan" as scanner
part start_key @button
part pause_key @button
part time @timer
part widen @extend generic_IN_WIDTH=16 generic_OUT_WIDTH=64
part display @pack generic_DIGITS=4
part scan @scanner generic_DIGITS=4
part separator CONST width=4 value="4"
connect clk -> start_key.clk, pause_key.clk, time.clk, scan.clk
connect rst -> start_key.rst, pause_key.rst, time.rst, scan.rst
connect en -> time.en, scan.en
connect start_button -> start_key.d
connect pause_button -> pause_key.d
connect start_key.pressed -> time.start
connect pause_key.pressed -> time.pause
connect load -> time.load
connect down -> time.down
connect load_minutes -> time.load_minutes
connect load_seconds -> time.load_seconds
connect time.digits -> widen.d
connect widen.y -> display.digits_in
connect separator.o -> display.dot
connect display.patterns_lo -> scan.patterns_lo
connect display.patterns_hi -> scan.patterns_hi
connect scan.segment -> segment
connect scan.dp -> dp
connect scan.digit -> common
connect time.running -> running
connect time.done -> done
connect time.valid -> valid
connect time.load_error -> load_error
